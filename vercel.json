{
"$schema": "https://openapi.vercel.sh/vercel.json",

"functions": {
"api/index.js": {
"includeFiles": "data/**"
}
},

"headers": [
{
"source": "/(.)\.(svg|png|jpg|jpeg|webp|ico|css|js|webmanifest)",
"headers": [
{
"key": "Cache-Control",
"value": "public, max-age=31536000, immutable"
}
]
},
{
"source": "/(.)",
"headers": [
{
"key": "X-Content-Type-Options",
"value": "nosniff"
},
{
"key": "Referrer-Policy",
"value": "strict-origin-when-cross-origin"
}
]
}
],

"rewrites": [
{
"source": "/api/(.)",
"destination": "/api/index.js"
},
{
"source": "/((?!.\.).*)",
"destination": "/api/index.js"
}
]
}
